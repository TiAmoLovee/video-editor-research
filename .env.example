# Template for native Python/CLI execution. Python does not automatically load this file.
# Export these variables in your terminal. Commands work when FFmpeg is on PATH.
FFMPEG=ffmpeg
FFPROBE=ffprobe
CLIPFORGE_DATA_DIR=./data
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Docker uses its own Linux paths and redis service name from compose.yaml.
