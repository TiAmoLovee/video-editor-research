# Template for native Python/CLI execution. Python does not automatically load this file.
# Export these variables in your terminal. Commands work when FFmpeg is on PATH.
FFMPEG=ffmpeg
FFPROBE=ffprobe
CLIPFORGE_DATA_DIR=./data
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Docker uses its own Linux paths and redis service name from compose.yaml.

# ASR: empty means automatic language detection; use zh or en for known language.
# Docker Compose reads this variable from .env; native Python needs an exported variable.
CLIPFORGE_ASR_LANGUAGE=
# Native model selection: base (default) or small; Python needs an exported variable.
# For Docker small, use compose.yaml together with compose.asr-small.yaml.
CLIPFORGE_ASR_MODEL=base
# Native optional override; Docker uses /models/faster-whisper-base from a read-only mount.
# CLIPFORGE_ASR_MODEL_DIR=./models/faster-whisper-base
