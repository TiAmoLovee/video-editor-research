{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClipForge rule-scored candidates (week 4 step 2 draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "stage",
    "input_result_kind",
    "analysis_sha256",
    "media",
    "generator",
    "candidate_count",
    "candidates",
    "warnings",
    "scoring",
    "windows_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft.2"
    },
    "artifact_kind": {
      "const": "scored_candidates"
    },
    "stage": {
      "const": "scored"
    },
    "input_result_kind": {
      "enum": [
        "measured",
        "synthetic_example"
      ]
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "normalized_sha256",
        "duration_seconds",
        "time_reference",
        "has_audio"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalized_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "time_reference": {
          "const": "normalized_video"
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "options"
      ],
      "properties": {
        "version": {
          "const": "sentence-window-v1"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_seconds",
            "max_seconds",
            "max_gap_seconds",
            "max_candidates"
          ],
          "properties": {
            "min_seconds": {
              "type": "number",
              "minimum": 15,
              "maximum": 90
            },
            "max_seconds": {
              "type": "number",
              "minimum": 15,
              "maximum": 90
            },
            "max_gap_seconds": {
              "type": "number",
              "minimum": 0
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_sentences",
          "overlong_sentence_unit_skipped",
          "no_eligible_window"
        ]
      }
    },
    "windows_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scorer",
        "version",
        "config",
        "config_sha256",
        "audio",
        "warnings",
        "score_meaning"
      ],
      "properties": {
        "scorer": {
          "const": "rule"
        },
        "version": {
          "const": "rule-v1"
        },
        "config": {
          "type": "object"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "audio": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable",
                    "no_audio"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "normalized_sha256",
                "duration_seconds",
                "pcm_sha256",
                "sample_rate_hz",
                "frame_seconds",
                "baseline_dbfs",
                "baseline_method",
                "window_method"
              ],
              "properties": {
                "status": {
                  "const": "measured"
                },
                "normalized_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "pcm_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sample_rate_hz": {
                  "const": 16000
                },
                "frame_seconds": {
                  "const": 0.1
                },
                "baseline_dbfs": {
                  "type": "number",
                  "minimum": -120,
                  "maximum": 0
                },
                "baseline_method": {
                  "type": "string"
                },
                "window_method": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "volume_unavailable_zero_contribution"
          }
        },
        "score_meaning": {
          "const": "heuristic priority, not probability or measured quality"
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "duration_seconds",
        "text",
        "source_sentences",
        "scoring_status",
        "score",
        "reasons",
        "scorer",
        "features",
        "rank"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c_[0-9a-f]{64}$"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 90
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_sentences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scoring_status": {
          "const": "scored"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scorer": {
          "const": "rule"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyword_density",
            "pace_change",
            "volume_peak",
            "qa_pattern",
            "duration_penalty"
          ],
          "properties": {
            "keyword_density": {
              "$ref": "#/$defs/feature"
            },
            "pace_change": {
              "$ref": "#/$defs/feature"
            },
            "volume_peak": {
              "$ref": "#/$defs/feature"
            },
            "qa_pattern": {
              "$ref": "#/$defs/feature"
            },
            "duration_penalty": {
              "$ref": "#/$defs/feature"
            }
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "contribution",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contribution": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}
