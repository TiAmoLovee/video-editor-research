{
  "name": "clipforge-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "vitest run --configLoader native --pool=threads"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7",
    "antd": "5.29.3",
    "@ant-design/icons": "5.6.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/node": "24.13.6",
    "vitest": "5.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1"
  }
}
